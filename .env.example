# ElevenLabs — get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Multilingual model (English + Mandarin). Alternatives: eleven_flash_v2_5 (low latency), eleven_v3
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional voice overrides (voice IDs from /api/voices)
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_ZH=
# Server
PORT=3000
TTS_CACHE=1
# CORS origin allowed to call /api/* (default "*"). Set to your GitHub Pages origin, e.g. https://9lordisgod.github.io
ALLOWED_ORIGIN=
