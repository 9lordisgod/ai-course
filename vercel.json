{
  "version": 2,
  "outputDirectory": "public",
  "functions": { "api/*.js": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/pitch/(.*)", "destination": "/pitch/$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!assets|data|api|pitch).*)", "destination": "/index.html" }
  ]
}
